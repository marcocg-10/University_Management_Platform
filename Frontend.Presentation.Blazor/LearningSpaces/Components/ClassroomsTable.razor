@using UCR.ECCI.PI.ThemePark.Frontend.Application.Buildings.Services
@using UCR.ECCI.PI.ThemePark.Frontend.Domain.LearningSpaces.Entities
@using UCR.ECCI.PI.ThemePark.Frontend.Presentation.Blazor.Core.Auth.Components
@using UCR.ECCI.PI.ThemePark.Frontend.Presentation.Blazor.Core.Components
@using UCR.ECCI.PI.ThemePark.Frontend.Presentation.Blazor.Core.Components.Icons

@inject IBuildingService BuildingService

@if (Classrooms is not null && Classrooms.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th class="header-cell-blue">Building</th>
                <th class="header-cell-blue">Floor Level</th>
                <th class="header-cell-blue">Room ID</th>
                <th class="header-cell-blue">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var classroom in Classrooms)
            {
                <tr>
                    <!-- Use dictionary to get Buildings' names by their ID. -->
                    <td class="data-cell-gray">
                        @if (!_buildingsLoaded)
                        {
                            <span class="text-muted fst-italic">Loading building...</span>
                        }
                        else
                        {
                            @(
                                classroom.BuildingId.HasValue &&
                                _buildingNames.TryGetValue(classroom.BuildingId.Value, out var name)
                                ? name
                                : "Unknown"
                                )
                            }
                    </td>
                    <td class="data-cell-gray">@classroom.FloorLevel</td>
                    <td class="data-cell-gray">@classroom.RoomId</td>
                    <td class="data-cell-gray">
                        <div class="d-flex gap-1">
                            <button class="btn btn-details-blue rounded-circle d-flex align-items-center justify-content-center p-0"
                                    style="width: 32px; height: 32px;"
                                    title="Details"
                                    aria-label="View classroom details"
                                    @onclick="() => ShowModal(classroom)">
                                <InfoIcon />
                            </button>

                            <PermissionGuard RequiredPermission="ManageLearningSpaces">
                                <button class="btn btn-edit-green2 rounded-circle small-circle-action-button"
                                        style="width: 32px; height: 32px;"
                                        title="Edit"
                                        aria-label="Edit classroom"
                                        @onclick="() => OnEdit.InvokeAsync(classroom.Id)">
                                    <EditIcon />
                                </button>

                                <button class="btn btn-delete-orange rounded-circle small-circle-action-button"
                                        style="width: 32px; height: 32px;"
                                        title="Delete"
                                        aria-label="Delete classroom"
                                        @onclick="() => OnDelete.InvokeAsync(classroom.Id)">
                                    <CrossIcon />
                                </button>
                            </PermissionGuard>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted fst-italic">No classrooms found.</p>
}

<ClassroomDetailsModal IsVisible="@isClassroomsDetailsModalVisible" OnClose="HideModal"
                        Classroom="@selectedClassroom" />

@code {
    /// <summary>
    /// List of classrooms to be displayed in the table.
    /// </summary>
    [Parameter] public IEnumerable<Classroom> Classrooms { get; set; } = Enumerable.Empty<Classroom>();

    /// <summary>
    /// Callback invoked when the edit button is clicked for a classroom.
    /// </summary>
    [Parameter] public EventCallback<int> OnEdit { get; set; }

    /// <summary>
    /// Callback invoked when the delete button is clicked for a classroom.
    /// </summary>
    [Parameter] public EventCallback<int> OnDelete { get; set; }

    /// <summary>
    /// Dictionary to cache building names by their IDs.
    /// </summary>
    private Dictionary<int, string> _buildingNames = new();

    /// <summary>
	/// Flag to indicate if buildings have been loaded.
    /// </summary>
    private bool _buildingsLoaded = false;

    /// <summary>
    /// Indicates whether the classroom details modal is visible.
    /// </summary>
    private bool isClassroomsDetailsModalVisible = false;

    /// <summary>
    /// The selected classroom for viewing details.
    /// </summary>
    private Classroom? selectedClassroom;

    /// <summary>
    /// Shows the classroom details modal for the specified classroom.
    /// </summary>
    private void ShowModal(Classroom classroom)
    {
        selectedClassroom = classroom;
        isClassroomsDetailsModalVisible = true;
    }

    /// <summary>
    /// Hides the classroom details modal.
    /// </summary>
    public void HideModal()
    {
        isClassroomsDetailsModalVisible = false;
        selectedClassroom = null;
    }

    protected override async Task OnInitializedAsync()
    {
		// Load building for display purposes.
        var buildings = await BuildingService.GetBuildingsAsync();

		// Cache building names.
        _buildingNames = buildings.ToDictionary(b => b.Id, b => b.Name);

		// Mark buildings as loaded.
        _buildingsLoaded = true;
    }
}
