@using UCR.ECCI.PI.ThemePark.Frontend.Domain.Permissions.Entities
@using UCR.ECCI.PI.ThemePark.Frontend.Domain.Roles.Entity
@using UCR.ECCI.PI.ThemePark.Frontend.Presentation.Blazor.Core.Components
@using UCR.ECCI.PI.ThemePark.Frontend.Presentation.Blazor.Core.Components.Icons

<Modal IsVisible="@IsVisible"
	   OnClose="OnClose"
	   ContentClass="@ContentClass"
	   ContentStyle="@ContentStyle"
	   OverlayClass="@OverlayClass"
	   OverlayStyle="@OverlayStyle">
	<h4><strong>Role details</strong></h4>
	@if (RoleObject is null)
	{
		<p>No role selected.</p>
	}
	else
	{
		<!-- Name -->
		<div class="d-flex flex-column gap-3 mb-3">
			<label class="form-label">Name</label>
			<div class="readonly-box">@RoleObject.Name.Value</div>
		</div>

		<!-- Permissions -->
		<div class="mt-4 w-100">
			<div class="mb-3">
				<label class="form-label">Assigned Permissions</label>
			</div>
			@if (Permissions is null || !Permissions.Any())
			{
				<p class="text-muted text-center">No permissions assigned.</p>
			}
			else
			{
				<ul class="list-group">
					@foreach (var permission in Permissions)
					{
						<li class="list-group-item d-flex justify-content-between align-items-center"
							style="background-color: #f5f5f5;">
							<span>@permission.Name.Value</span>							
						</li>
					}
				</ul>
			}
		</div>
	}
</Modal>

@code {
	[Parameter] public bool IsVisible { get; set; }
	[Parameter] public EventCallback OnClose { get; set; }
	[Parameter] public Role? RoleObject { get; set; }

	
	[Parameter] public IEnumerable<Permission>? Permissions { get; set; }

	[Parameter] public string? OverlayClass { get; set; }
	[Parameter] public string? OverlayStyle { get; set; }
	[Parameter] public string? ContentClass { get; set; }
	[Parameter] public string? ContentStyle { get; set; }

}
