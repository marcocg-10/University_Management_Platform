@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Logging
@using UCR.ECCI.PI.ThemePark.Frontend.Application.Roles.Services
@using UCR.ECCI.PI.ThemePark.Frontend.Domain.Permissions.Entities
@using UCR.ECCI.PI.ThemePark.Frontend.Domain.Roles.Entity
@using UCR.ECCI.PI.ThemePark.Frontend.Domain.Roles.Exceptions
@using UCR.ECCI.PI.ThemePark.Frontend.Presentation.Blazor.Core.Components
@using UCR.ECCI.PI.ThemePark.Frontend.Presentation.Blazor.Core.Components.Icons
@inject ILogger<AssignPermissionsModal> Logger
@inject IRoleService RoleService
@inject IToastService ToastService

<Modal IsVisible="@IsVisible"
       OnClose="OnClose"
       ContentClass="@ContentClass"
       ContentStyle="@ContentStyle"
       OverlayClass="@OverlayClass"
       OverlayStyle="@OverlayStyle">
    <h4><strong>Role details</strong></h4>
    @if (RoleObject is null)
    {
        <p>No role selected.</p>
    }
    else
    {
        <!-- Name -->
        <div class="d-flex flex-column gap-3 mb-3">
            <label class="form-label">Name</label>
            <div class="readonly-box">@RoleObject.Name.Value</div>
        </div>

        <!-- Permissions -->
        <div class="mb-3">
            <div class="mb-3">
                <label class="form-label">Assigned Permissions</label>
            </div>

            <!-- Permission dropdown selector below the title -->        
            <div class="d-flex flex-column gap-3 mb-3">
                <RadzenStack Orientation="Orientation.Vertical"
                                Gap="0.2rem"
                                class="d-flex flex-column gap-3 mb-3">
                    <RadzenStack Orientation="Orientation.Horizontal"
                                    AlignItems="AlignItems.Center"
                                    Gap="0.5rem">
                        <RadzenDropDown @bind-Value=@selectedPermissions
                                        Data=@AvailablePermissions
                                        TextProperty="Name.Value"
                                        ValueProperty="Id"
                                        Name="PermissionDropDown"
                                        Multiple=true
                                        SelectAllText="Select All"
                                        Placeholder="Select permissions to assign"
                                        MaxSelectedLabels="2"
                                        SelectedItemsText="permissions selected"                                      
                                        Style="flex-grow: 2; min-width: 250px;" >
                            <EmptyTemplate>
                                <div class="text-muted fst-italic text-center py-2" style="font-size: 0.9rem;">
                                     No available permissions 
                                </div>
                            </EmptyTemplate>
                        </RadzenDropDown>
                        <RadzenButton Click=@HandleAssignSelectedPermissions
                                        Icon="add"
                                        Class="rz-border-radius-4"
                                        Style="background-color: #204c6f; border-color: #204c6f;"                                       
                                        Size="ButtonSize.Small"
                                        Disabled="@(!selectedPermissions.Any())"                                     
                                        title="Assign Selected Permissions" />
                    </RadzenStack>
                </RadzenStack>
            </div>
            
            @if (Permissions is null || !Permissions.Any())
            {
                <p class="text-muted text-center">No permissions assigned.</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var permission in Permissions)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center"
                            style="background-color: #f5f5f5;">
                            <span>@permission.Name.Value</span>
                        </li>
                    }
                </ul>
            }
        </div>
    }
</Modal>


@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
	[Parameter] public EventCallback OnAssign { get; set; }
    [Parameter] public Role? RoleObject { get; set; }

    [Parameter] public IEnumerable<Permission>? AvailablePermissions { get; set; }
    [Parameter] public IEnumerable<Permission>? Permissions { get; set; }

    [Parameter] public string? OverlayClass { get; set; }
    [Parameter] public string? OverlayStyle { get; set; }
    [Parameter] public string? ContentClass { get; set; }
    [Parameter] public string? ContentStyle { get; set; }


    // Use HashSet for selected permissions
    private IList<int> selectedPermissions { get; set; } = new List<int>();


    private bool _saving;

    protected override void OnParametersSet()
    {
        // Reset selected permissions when modal opens
        selectedPermissions.Clear();
    }

    private async Task HandleAssignSelectedPermissions()
    {
        if (RoleObject is null)
            return;

        if (!selectedPermissions.Any())
        {
            ToastService.ShowWarning("Please select at least one permission to assign.");
            return;
        }

        if (_saving) return;
        _saving = true;

		var selected = AvailablePermissions!.Where(p => selectedPermissions.Contains(p.Id)).ToList();

        int successCount = 0;
        List<string> errors = new();

        foreach (var permission in selected)
        {
            try
            {
                var errorMessage = await RoleService.AssociatePermissionAsync(RoleObject, permission);
                if (errorMessage is null)
                {
                    successCount++;
                    ToastService.ShowSuccess($"Permission '{permission.Name.Value}' assigned to role '{RoleObject.Name.Value}'.");
                }
                else
                {
                    errors.Add($"{permission.Name.Value}: {errorMessage}");
                    ToastService.ShowError($"Failed to assign '{permission.Name.Value}' to role '{RoleObject.Name.Value}': {errorMessage}");
                }
            }
            catch (RoleNotFoundException ex)
            {
                errors.Add($"{permission.Name.Value}: {ex.Message}");
                ToastService.ShowError($"Failed to assign '{permission.Name.Value}' to role '{RoleObject.Name.Value}': {ex.Message}");
            }
            catch (AssignablePermissionNotFoundException ex)
            {
                errors.Add($"{permission.Name.Value}: An unexpected error occurred.");
                ToastService.ShowError($"Failed to assign '{permission.Name.Value}' to role '{RoleObject.Name.Value}': An unexpected error occurred.");
            }
            catch (PermissionAlreadyAssignedException ex)
            {
                errors.Add($"{permission.Name.Value}: {ex.Message}");
                ToastService.ShowError($"Failed to assign '{permission.Name.Value}' to role '{RoleObject.Name.Value}': {ex.Message}");
            }
            catch (RoleException ex)
            {
                errors.Add($"{permission.Name.Value}: {ex.Message}");
                ToastService.ShowError($"Failed to assign '{permission.Name.Value}' to role '{RoleObject.Name.Value}': {ex.Message}");
            }
            catch (ArgumentNullException ex)
            {
                errors.Add($"{permission.Name.Value}: An unexpected error occurred.");
                ToastService.ShowError($"Failed to assign '{permission.Name.Value}' to role '{RoleObject.Name.Value}': An unexpected error occurred.");
			}
            catch (Exception ex)
            {
                Logger.LogError(ex, "Exception occurred while assigning permission {PermissionName}", permission.Name.Value);

                errors.Add($"{permission.Name.Value}: An unexpected error occurred.");
                ToastService.ShowError($"Failed to assign '{permission.Name.Value}' to role '{RoleObject.Name.Value}': An unexpected error occurred.");
            }

        }

        _saving = false;

        // Build final summary toast
        if (errors.Any())
        {
            ToastService.ShowWarning($" Successful: {successCount} |  Failed: {errors.Count} ");
        }
        else
        {
            ToastService.ShowSuccess($" Successfully assigned {successCount} permission(s)!");
        }
		await OnAssign.InvokeAsync();
        //await CloseModal();
    }

    private async Task CloseModal()
    {
        await OnClose.InvokeAsync();
    }
}
